generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPERADMIN
  OPS_DISPATCHER
  TECHNICIAN
  VENDOR_PRINTER
  CUSTOMER
}

enum LeadStatus {
  NEW
  WHATSAPP_SENT
  VAN_DISPATCHED
  MEASURED
  QUOTE_LOCKED
  WON
  LOST
}

enum OrderStage {
  DEPOSIT_PENDING
  DEPOSIT_PAID
  MATERIAL_RELEASED
  INSTALL_READY
  POST_QA_UNLOCK_PENDING
  COMPLETED
}

enum ItemCategory {
  BOTANICAL
  FLUTED_LOUVER
  NEO_CLASSICAL
  GEOMETRIC
  TEMPLE_PICHWAI
  SMART_BLINDS
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  phone     String?  @unique
  name      String
  role      Role     @default(CUSTOMER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  leads         Lead[]
  orders        Order[]
  installations Installation[] @relation("TechInstallations")
}

model SocietyLayout {
  id                  String   @id @default(uuid())
  societyName         String
  tower               String
  unitType            String // e.g., 2BHK, 3BHK
  presetWallSpecs     Json     // { wallWidth, wallHeight, windowAspect, compassOrientation }
  discountMultiplier  Float    @default(1.0) // For viral loop discounts
  totalUnitsCompleted Int      @default(0) // Viral loop tracking
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  leads               Lead[]
}

model DesignItem {
  id                    String       @id @default(uuid())
  sku                   String       @unique
  title                 String
  category              ItemCategory
  textureMapUrl         String?
  highResPrintUrl       String?
  baseRateSqFt          Float
  patternRepeatHeightCm Float
  rollWidthInches       Float?
  isActive              Boolean      @default(true)
  dyeLots               DyeLot[]
}

model DyeLot {
  id             String     @id @default(uuid())
  designItem     DesignItem @relation(fields: [designItemId], references: [id])
  designItemId   String
  cmykLotCode    String
  substrateBatch String
  rollSerial     String     @unique
  stockMeters    Float
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  orderItems     OrderItem[]
}

model Lead {
  id                    String         @id @default(uuid())
  customer              User?          @relation(fields: [customerId], references: [id])
  customerId            String?
  customerName          String
  phone                 String
  society               SocietyLayout? @relation(fields: [societyId], references: [id])
  societyId             String?
  status                LeadStatus     @default(NEW)
  moistureLevelPercent  Float?
  wallSoundnessScore    Int? // 1-10
  // Lead auto-routing (spec-lead-auto-routing): anonymous web captures
  sessionId             String?        @unique
  quizAnswers           Json?
  source                String?        // quiz|estimator|visualize|shop-look
  assignedAgent         SalesAgent?    @relation(fields: [assignedAgentId], references: [id])
  assignedAgentId       String?
  routedAt              DateTime?
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt
  orders                Order[]
}

model SalesAgent {
  id        String   @id @default(uuid())
  name      String   @unique
  phone     String
  cities    String[]
  societies String[]
  isActive  Boolean  @default(true)
  weight    Int      @default(1)
  isDemo    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  leads     Lead[]
}

model Order {
  id                  String     @id @default(uuid())
  lead                Lead       @relation(fields: [leadId], references: [id])
  leadId              String
  customer            User       @relation(fields: [customerId], references: [id])
  customerId          String
  cutSheetUrl         String?
  totalAmount         Float
  escrowStage         OrderStage @default(DEPOSIT_PENDING)
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt
  items               OrderItem[]
  warranty            WarrantyVault?
  escrowTransactions  EscrowTransaction[]
  installation        Installation?
}

model OrderItem {
  id                  String   @id @default(uuid())
  order               Order    @relation(fields: [orderId], references: [id])
  orderId             String
  dyeLot              DyeLot?  @relation(fields: [dyeLotId], references: [id])
  dyeLotId            String?
  wallWidthFt         Float
  wallHeightFt        Float
  computedSqFt        Float
  nestingBufferSqFt   Float
  price               Float
}

model WarrantyVault {
  id                  String   @id @default(uuid())
  order               Order    @relation(fields: [orderId], references: [id])
  orderId             String   @unique
  laserDimensionsJson Json     // Store exact finalized dimensions
  rollSerials         String[] // Track dye lot serials used
  status              String   @default("ACTIVE") // ACTIVE, CLAIMED, EXPIRED
  expiresAt           DateTime
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

enum EscrowStage {
  DEPOSIT_10
  MATERIAL_60
  QA_30
}

enum TransactionStatus {
  PENDING
  PAID
  REFUNDED
}

model EscrowTransaction {
  id        String            @id @default(uuid())
  order     Order             @relation(fields: [orderId], references: [id])
  orderId   String
  stage     EscrowStage
  status    TransactionStatus @default(PENDING)
  amount    Float
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
}

enum InstallStatus {
  SCHEDULED
  IN_PROGRESS
  QA_PENDING
  COMPLETED
}

model Van {
  id            String         @id @default(uuid())
  vehicleNumber String         @unique
  city          String
  status        String         @default("AVAILABLE")
  installations Installation[]
}

model Installation {
  id           String        @id @default(uuid())
  order        Order         @relation(fields: [orderId], references: [id])
  orderId      String        @unique
  technician   User?         @relation(name: "TechInstallations", fields: [technicianId], references: [id])
  technicianId String?
  van          Van?          @relation(fields: [vanId], references: [id])
  vanId        String?
  scheduledAt  DateTime
  status       InstallStatus @default(SCHEDULED)
  startedAt    DateTime?
  completedAt  DateTime?
  qaReport     QAReport?
}

model QAReport {
  id              String       @id @default(uuid())
  installation    Installation @relation(fields: [installationId], references: [id])
  installationId  String       @unique
  moistureReading Float
  customerSigned  Boolean      @default(false)
  warrantyStatus  String       @default("PENDING")
  createdAt       DateTime     @default(now())
}
